# ── 공개 (클라이언트 노출) ──────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_KAKAO_CHANNEL_URL=https://pf.kakao.com/_xxxxx/chat
# 회사 정보 (없으면 data/company.json 사용)
# NEXT_PUBLIC_COMPANY_BRAND=
# NEXT_PUBLIC_COMPANY_BRAND_EN=
# NEXT_PUBLIC_COMPANY_NAME=
# NEXT_PUBLIC_COMPANY_CEO=
# NEXT_PUBLIC_COMPANY_BIZ_NO=
# NEXT_PUBLIC_COMPANY_ADDRESS=
# NEXT_PUBLIC_COMPANY_MAIL_ORDER_NO=
# NEXT_PUBLIC_COMPANY_PRIVACY_OFFICER=
# NEXT_PUBLIC_COMPANY_EMAIL=
# NEXT_PUBLIC_COMPANY_PHONE=
# NEXT_PUBLIC_COMPANY_HOURS=

# ── 본인확인 어댑터: mock | portone | tilko (키 없으면 항상 mock) ──
AUTH_PROVIDER=mock
MOCK_AUTH_DELAY_MS=5000
# PORTONE_API_SECRET=
# PORTONE_STORE_ID=
# PORTONE_CHANNEL_KEY=
# TILKO_API_KEY=
# TILKO_BASE_URL=https://api.tilko.net

# ── 저장소: 없으면 data/inquiries.local.json 폴백 (Vercel 운영 시 필수) ──
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── 관리자 ──
ADMIN_PASSWORD=change-me
# 신청 접수 시 관리자 알림 webhook (Slack/Discord 등)
# ADMIN_WEBHOOK_URL=
